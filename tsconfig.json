{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "typeRoots": ["node_modules/@figma", "node_modules/@types"],
    "types": ["plugin-typings"]
  },
  "include": [
    "src/shared/env.d.ts",
    "test/**/*.ts",
    "src/main/**/*.test.ts",
    "src/shared/**/*.test.ts",
    "src/codegen/**/*.test.ts"
  ]
}
