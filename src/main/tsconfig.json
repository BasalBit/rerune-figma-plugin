{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2017",
    "lib": ["ES2020"],
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "typeRoots": ["../../node_modules/@figma"],
    "types": ["plugin-typings"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../codegen/**/*.ts"]
}
